<?xml version="1.0" encoding="utf-8"?>
<!-- {VERSION} は Build-Msix.ps1 がタグから生成する 4 要素バージョンに置換する -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop6 rescap">

  <Identity
    Name="scottlz0310.dsx"
    Publisher="CN=scottlz0310"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>dsx</DisplayName>
    <PublisherDisplayName>scottlz0310</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- dsx が起動する go / npm / winget 等の書き込みがパッケージ専用領域へリダイレクトされると、
         グローバルツールの更新結果が他のシェルから見えなくなるため、ファイル・レジストリの仮想化を無効化する -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="dsx" Executable="dsx.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="dsx"
        Description="開発環境の日次メンテナンスツール"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <!-- CLI として PATH（%LOCALAPPDATA%\Microsoft\WindowsApps）から dsx を呼び出せるようにする -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="dsx.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="dsx.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
